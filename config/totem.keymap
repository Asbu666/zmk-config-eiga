#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Nav         1
#define Sym         2
#define Fun         3
#define Game        4
#define Gameplus    5

&mt {
    quick-tap-ms = <110>;
    flavor = "balanced";
    tapping-term-ms = <220>;
};

&lt {
    tapping-term-ms = <300>;
    flavor = "balanced";
    quick-tap-ms = <125>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <260>;
            quick-tap-ms = <125>;
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <50>;
        };

        ts: StickyToggle {
            compatible = "zmk,behavior-hold-tap";
            label = "StickyToggle";
            bindings = <&tog>, <&sl>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
        };
    };

    combos {
        compatible = "zmk,combos";

        lbckspc_as {
            bindings = <&kp BACKSPACE>;
            key-positions = <10 11>;
            timeout-ms = <50>;
        };

        rbckspc_lsemi {
            bindings = <&kp BACKSPACE>;
            key-positions = <19 18>;
        };

        F12_F10F11 {
            bindings = <&kp F12>;
            key-positions = <8 9>;
            timeout-ms = <50>;
            layers = <1>;
        };

        F1_F2F3 {
            bindings = <&kp F1>;
            key-positions = <0 1>;
            timeout-ms = <50>;
            layers = <1>;
        };

        Tab_qw {
            bindings = <&kp TAB>;
            key-positions = <0 1>;
            layers = <1>;
            timeout-ms = <50>;
        };

        Enter_op {
            bindings = <&kp ENTER>;
            key-positions = <8 9>;
            timeout-ms = <50>;
            layers = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "0";
            bindings = <
                &kp Q  &kp W       &kp E       &kp R        &kp T    &kp Y  &kp U        &kp I       &kp O       &kp P
                &kp A  &mt LALT S  &mt LGUI D  &mt LCTRL F  &kp G    &kp H  &mt RCTRL J  &mt RGUI K  &mt RALT L  &kp SEMI
&mt CAPS LSHFT  &kp Z  &kp X       &kp C       &kp V        &kp B    &kp N  &kp M        &kp COMMA   &kp PERIOD  &kp SLASH  &mt CAPS RSHFT
                                   &sl 2       &kp SPACE    &sl 1    &mo 1  &kp SPACE    &mo 2
            >;
        };

        FuncyNums {
            display-name = "1";
            bindings = <
        &kp F2    &kp F3       &kp F4       &kp F5        &kp F6       &kp F7     &kp F8        &kp F9            &kp F10            &kp F11
        &kp N1    &mt LALT N2  &mt LGUI N3  &mt LCTRL N4  &kp N5       &kp N6     &mt RCTRL N7  &mt RGUI N8       &mt RALT N9        &kp N0
&trans  &kp LEFT  &kp UP       &kp DOWN     &kp RIGHT     &kp GRAVE    &kp MINUS  &kp EQUAL     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH  &trans
                               &kp CAPS     &to 2         &to 2        &to 2      &to 2         &kp CAPS
            >;
        };

        FuncyMed {
            display-name = "2";
            bindings = <
        &none         &none           &none             &none          &none           &none         &none       &none             &none       &none
        &kp PSCRN     &mt LALT PG_UP  &mt LGUI PG_DN    &mt LCTRL INS  &none           &none         &kp END     &kp PAUSE_BREAK   &kp HOME    &none
&trans  &kp C_VOL_DN  &kp C_PREV      &kp C_PLAY_PAUSE  &kp C_NEXT     &kp C_VOL_UP    &kp C_VOL_UP  &kp C_NEXT  &kp C_PLAY_PAUSE  &kp C_PREV  &kp C_VOL_DN  &trans
                                      &to 3             &to 0          &to 0           &to 0         &to 0       &to 3
            >;
        };

        Gaming {
            display-name = "3";
            bindings = <
       &kp CAPS        &kp Q  &kp W  &kp E      &kp T    &none    &none        &none          &none  &none
       &kp LEFT_SHIFT  &kp A  &kp S  &kp D      &kp F    &kp F5   &kp ESC      &none          &none  &none
&sl 4  &kp LCTRL       &kp Z  &kp X  &kp C      &kp V    &kp F12  &none        &none          &none  &none  &none
                              &kp R  &kp SPACE  &kp G    &to 0    &kp LS(TAB)  &kp BACKSPACE
            >;
        };

        Gaming+ {
            display-name = "4";
            bindings = <
         &kp I    &kp N7  &kp N8  &kp N9  &kp U    &none    &none        &none          &none  &none
         &kp TAB  &kp N1  &kp N2  &kp N3  &kp H    &kp F5   &kp ESC      &none          &none  &none
&kp ESC  &kp M    &kp N4  &kp N5  &kp N6  &kp N    &kp F12  &none        &none          &none  &kp LC(LA(ESCAPE))  &kp LA(F4)
                          &kp J   &kp K   &kp L    &to 0    &kp LS(TAB)  &kp BACKSPACE
            >;
        };
    };
};
