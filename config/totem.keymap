#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Nav         1
#define Sym         2
#define Fun         3
#define Game        4
#define Gameplus    5

&mt {
    quick-tap-ms = <125>;
    flavor = "balanced";
    tapping-term-ms = <260>;
};

&lt {
    tapping-term-ms = <300>;
    flavor = "balanced";
    quick-tap-ms = <125>;
};

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <260>;
            quick-tap-ms = <125>;
            bindings = <&kp>, <&kp>;

            require-prior-idle-ms = <80>;
            hold-while-undecided;
            hold-trigger-key-positions = <13 12 11 10 16 17 18 19>;
            hold-trigger-on-release;
        };

        ts: StickyToggle {
            compatible = "zmk,behavior-hold-tap";
            label = "StickyToggle";
            bindings = <&tog>, <&sl>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <125>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "0";
            bindings = <
         &kp Q        &kp W       &kp E       &kp R        &kp T      &kp Y      &kp U        &kp I          &kp O       &kp P
         &hm LSHFT A  &hm LALT S  &hm LGUI D  &hm LCTRL F  &kp G      &kp H      &hm RCTRL J  &hm RGUI K     &hm RALT L  &hm RSHFT SEMI
&kp ESC  &kp Z        &kp X       &kp C       &kp V        &kp B      &kp N      &kp M        &kp COMMA      &kp PERIOD  &kp SLASH       &kp APOS
                                  &kp DEL     &lt 1 SPACE  &kp TAB    &kp ENTER  &lt 1 COLON  &kp BACKSPACE
            >;
        };

        Navigation {
            display-name = "1";
            bindings = <
        &kp F2        &kp F3       &kp F4       &kp F5        &kp F6       &kp F7     &kp F8        &kp F9            &kp F10            &kp F11
        &hm LSHFT N1  &hm LALT N2  &hm LGUI N3  &hm LCTRL N4  &kp N5       &kp N6     &hm RCTRL N7  &hm RGUI N8       &hm RALT N9        &hm RSHFT N0
&kp F1  &kp LEFT      &kp UP       &kp DOWN     &kp RIGHT     &kp GRAVE    &kp MINUS  &kp EQUAL     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH  &kp F12
                                   &kp CAPS     &to 2         &to 2        &to 2      &to 2         &kp CAPS
            >;
        };

        Numbers {
            display-name = "2";
            bindings = <
       &none         &none       &none             &none       &none           &none         &none       &none             &none       &none
       &kp PSCRN     &kp PG_DN   &kp PG_UP         &kp INS     &none           &none         &kp END     &kp PAUSE_BREAK   &kp HOME    &none
&none  &kp C_VOL_DN  &kp C_PREV  &kp C_PLAY_PAUSE  &kp C_NEXT  &kp C_VOL_UP    &kp C_VOL_UP  &kp C_NEXT  &kp C_PLAY_PAUSE  &kp C_PREV  &kp C_VOL_DN  &none
                                 &to 3             &to 0       &to 0           &to 0         &to 0       &to 3
            >;
        };

        Gaming {
            display-name = "3";
            bindings = <
       &kp CAPS        &kp Q  &kp W  &kp E      &kp T    &none    &none        &none          &none  &none
       &kp LEFT_SHIFT  &kp A  &kp S  &kp D      &kp F    &kp F5   &kp ESC      &none          &none  &none
&sl 4  &kp LCTRL       &kp Z  &kp X  &kp C      &kp V    &kp F12  &none        &none          &none  &none  &none
                              &kp R  &kp SPACE  &kp G    &to 0    &kp LS(TAB)  &kp BACKSPACE
            >;
        };

        Gaming+ {
            display-name = "4";
            bindings = <
         &kp I    &kp N7  &kp N8  &kp N9  &kp U    &none    &none        &none          &none  &none
         &kp TAB  &kp N1  &kp N2  &kp N3  &kp H    &kp F5   &kp ESC      &none          &none  &none
&kp ESC  &kp M    &kp N4  &kp N5  &kp N6  &kp N    &kp F12  &none        &none          &none  &kp LC(LA(ESCAPE))  &kp LA(F4)
                          &kp J   &kp K   &kp L    &to 0    &kp LS(TAB)  &kp BACKSPACE
            >;
        };
    };
};
